{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "module": "ESNext",
    "skipLibCheck": true,
    "composite": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict mode — non-negotiable per plan.md Technical Context */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,

    /* Path aliases per plan.md Project Structure (resolved relative to this file
       under "moduleResolution": "bundler" — no "baseUrl" needed; it is deprecated
       as of TypeScript 6 and would be removed in 7) */
    "paths": {
      "@app/*": ["./src/app/*"],
      "@design-system/*": ["./src/design-system/*"],
      "@entities/*": ["./src/entities/*"],
      "@features/*": ["./src/features/*"],
      "@routes/*": ["./src/routes/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src"]
}
