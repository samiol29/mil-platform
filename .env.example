# ---------------------------------------------------------------------------
# MIL Platform — Environment Configuration Template
#
# Copy this file to .env and fill in values for your deployment.
# .env is excluded from version control (.gitignore).
# Never commit secrets, credentials, or connection strings.
#
# For local development, use the defaults provided below with docker-compose.
# For production, all values must be set explicitly and managed through a
# dedicated secret management system.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Deployment environment: development | staging | production
MIL_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
MIL_LOG_LEVEL=INFO

# API server bind address and port
MIL_HOST=0.0.0.0
MIL_PORT=8000

# Secret key for signing internal tokens (generate with: openssl rand -hex 32)
MIL_SECRET_KEY=changeme-use-openssl-rand-hex-32-in-production

# ---------------------------------------------------------------------------
# PostgreSQL (primary relational store)
# ---------------------------------------------------------------------------

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mil
POSTGRES_USER=mil
POSTGRES_PASSWORD=changeme

# Full async DSN (constructed from the above in config.py; can be overridden)
# DATABASE_URL=postgresql+asyncpg://mil:changeme@localhost:5432/mil

# Synchronous DSN used by Alembic migrations only
# ALEMBIC_DATABASE_URL=postgresql+psycopg2://mil:changeme@localhost:5432/mil

# ---------------------------------------------------------------------------
# Object Storage (S3-compatible — MinIO for local, S3 or equivalent for prod)
# ---------------------------------------------------------------------------

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=mil-documents
STORAGE_REGION=us-east-1

# ---------------------------------------------------------------------------
# Message Broker (backing store for EventBus and JobQueue abstractions)
# The broker implementation is replaceable — Redis is the default for local dev.
# ---------------------------------------------------------------------------

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# Broker URL (constructed from the above; can be overridden for AMQP-compatible brokers)
# BROKER_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Inference provider (AI Copilot / Findings)
#
# The inference layer is provider-agnostic: business logic depends only on the
# InferenceProvider interface, and the concrete implementation is selected here
# and wired via dependency injection (mil.kernel.container). Gemini is the only
# implemented provider today; Claude / OpenAI / Azure OpenAI / vLLM / Ollama are
# added by implementing InferenceProvider and adding a branch to
# _build_inference_provider — no business-logic change.
# ---------------------------------------------------------------------------

# Which InferenceProvider to wire: gemini (only implemented value today)
INFERENCE_PROVIDER=gemini

# --- Google Gemini AI Studio ---
# Required when INFERENCE_PROVIDER=gemini. Obtain from Google AI Studio.
# This is a secret — never commit it; supply it from your secret manager.
# Application startup FAILS FAST if this is missing (there is no mock fallback).
GEMINI_API_KEY=AQ.Ab8RN6IU8cCt3bMcSI1zNG1JhpEm5TDHUd5xowxEHVlEJ1i12g

# Model id: gemini-2.5-flash (default, faster/cheaper) or gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Generative Language API base URL (version-pinned; rarely changed)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Default sampling temperature (0.0 = most deterministic; regulated default)
GEMINI_TEMPERATURE=0.0

# Default response token budget
GEMINI_MAX_OUTPUT_TOKENS=1024

# Per-request HTTP timeout (seconds)
GEMINI_TIMEOUT_SECONDS=30

# Max retries after the first attempt for transient failures (429/5xx/timeouts),
# using exponential backoff with jitter
GEMINI_MAX_RETRIES=4

# ---------------------------------------------------------------------------
# Document Intelligence (OCR / Extraction)
#
# Same provider-agnostic DI seam as inference: business logic depends only on
# OCRProvider / ExtractionProvider; the concrete implementation is selected
# here (mil.kernel.container._build_ocr_provider / _build_extraction_provider).
# Gemini's native multimodal document understanding replaces traditional OCR —
# there is no Tesseract-style engine in this platform.
# ---------------------------------------------------------------------------

# Which OCRProvider / ExtractionProvider to wire: gemini (only implemented
# value today)
OCR_PROVIDER=gemini
EXTRACTION_PROVIDER=gemini

# Model id per stage — can differ from GEMINI_MODEL (e.g. a lighter/cheaper
# model for extraction). API key, base URL, timeout, and retry budget are
# shared with inference (GEMINI_API_KEY etc. above) — one secret, one retry
# policy, three call sites.
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_EXTRACTION_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# OpenTelemetry (observability)
# ---------------------------------------------------------------------------

# OTLP exporter endpoint (e.g., Jaeger, Tempo, or managed APM)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=mil-api

# Set to "none" to disable export in local development
# OTEL_TRACES_EXPORTER=otlp

# ---------------------------------------------------------------------------
# Identity Provider
# ---------------------------------------------------------------------------

# JWT signing algorithm and public key / JWKS URI (populated in T032)
# AUTH_ALGORITHM=RS256
# AUTH_JWKS_URI=

# ---------------------------------------------------------------------------
# Data Residency
# ---------------------------------------------------------------------------

# Deployment region — used to enforce data residency constraints
# MIL_REGION=

# ---------------------------------------------------------------------------
# Worker Configuration
# ---------------------------------------------------------------------------

# Maximum number of concurrent jobs per worker process
WORKER_CONCURRENCY=4

# Job queue visibility timeout in seconds (jobs re-queued if not ACKed within)
WORKER_JOB_TIMEOUT=120
